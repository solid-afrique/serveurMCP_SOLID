<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuration IIS du serveur MCP (Laravel). Le site IIS doit pointer sur ce dossier « public ».
  Prérequis : PHP en FastCGI (gestionnaire *.php) et le module URL Rewrite.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <!-- Supprime la barre oblique finale (sauf pour un vrai dossier). -->
        <rule name="Sans barre finale" stopProcessing="true">
          <match url="^(.*)/$" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
          </conditions>
          <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
        </rule>
        <!-- Tout ce qui n'est pas un fichier existant (css, js…) est traité par Laravel. -->
        <rule name="Laravel" stopProcessing="true">
          <match url="^" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>

    <!-- Les réponses d'erreur JSON (401 OAuth, 403, 404…) doivent arriver telles quelles aux assistants. -->
    <httpErrors existingResponse="PassThrough" />

    <!-- WebDAV intercepterait les requêtes DELETE / PUT. -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>

    <security>
      <requestFiltering>
        <!-- Les URL OAuth (PKCE, state, resource) peuvent dépasser la limite par défaut. -->
        <requestLimits maxQueryString="8192" maxUrl="8192" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
