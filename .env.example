# Clé de chiffrement des paramètres de connexion stockés (obligatoire, 16 caractères minimum).
# Générez-la avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Attention : la changer rend illisibles toutes les connexions enregistrées.
ENCRYPTION_KEY=

# Compte administrateur (obligatoire) : gère les connexions, les utilisateurs et leurs accès.
# Identifiant de connexion de l'administrateur (par défaut « admin »).
# ADMIN_EMAIL=admin
# Le changer ferme les sessions de l'administrateur, mais ne révoque pas les assistants qu'il a autorisés.
ADMIN_PASSWORD=

# Redis de stockage (obligatoire en production) : connexions, clients OAuth, jetons.
# Upstash : copiez l'URL « rediss:// » de la console. Sur Vercel, l'intégration Upstash fournit REDIS_URL ou KV_URL.
# En développement, sans cette variable, le stockage se fait en mémoire.
REDIS_URL=

# Optionnel : URL publique du serveur (sinon déduite de la requête). Recommandé avec un domaine personnalisé.
# PUBLIC_BASE_URL=https://mon-serveur-mcp.vercel.app
