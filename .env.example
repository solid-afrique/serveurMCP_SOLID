# Configuration du serveur MCP (Laravel). Copiez ce fichier en .env et complétez-le.

APP_NAME="Serveur MCP"
# production sur le serveur ; local sur un poste de développement.
APP_ENV=production
# Générée par « php artisan key:generate ». Chiffre aussi les paramètres des connexions :
# SAUVEGARDEZ-LA à part. Sans elle, les connexions enregistrées sont irrécupérables.
APP_KEY=
# Toujours false en production : sinon les erreurs détaillées sont renvoyées aux assistants.
APP_DEBUG=false
# Adresse publique HTTPS du site IIS, sans « / » final.
APP_URL=https://mcp.exemple.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Journaux quotidiens dans storage\logs (conservés 14 jours).
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Base MySQL de l'application : utilisateurs, administrateurs, connexions chiffrées, jetons OAuth.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mcp_server
DB_USERNAME=mcp_server
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie de session uniquement en HTTPS (à mettre à false seulement pour un essai en HTTP).
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Envoi des liens d'invitation par e-mail (SMTP). Testez avec « php artisan mcp:mail-test vous@exemple.com ».
# Avec MAIL_MAILER=log, aucun e-mail n'est envoyé : le lien est seulement affiché à l'administrateur.
# Microsoft 365 : smtp.office365.com, port 587 (STARTTLS automatique). Port 465 : ajoutez MAIL_SCHEME=smtps.
# Relais SMTP interne sans authentification : laissez MAIL_USERNAME et MAIL_PASSWORD vides.
MAIL_MAILER=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
# Entre guillemets si le mot de passe contient des espaces ou # $ " =
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=mcp@exemple.com
MAIL_FROM_NAME="${APP_NAME}"

# Domaines de retour OAuth autorisés pour les assistants (liste séparée par des virgules).
# Par défaut : Claude, ChatGPT, VS Code et localhost. « * » autorise tout (déconseillé).
# MCP_REDIRECT_DOMAINS=https://claude.ai,https://claude.com,https://chatgpt.com,https://chat.openai.com,https://vscode.dev,https://insiders.vscode.dev,http://localhost,http://127.0.0.1

# Seulement si un proxy inverse (ARR, répartiteur de charge) est placé devant IIS :
# adresses IP de ce proxy, ou « * ». Inutile avec PHP directement dans IIS.
# TRUSTED_PROXIES=
