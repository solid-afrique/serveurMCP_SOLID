# Clé de chiffrement des paramètres de connexion stockés (obligatoire, 16 caractères minimum).
# Générez-la avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Attention : la changer rend illisibles toutes les connexions enregistrées.
ENCRYPTION_KEY=

# Compte administrateur (obligatoire) : gère les connexions, les utilisateurs et leurs accès.
# Identifiant de connexion de l'administrateur (par défaut « admin »).
# ADMIN_EMAIL=admin
# Le changer ferme les sessions de l'administrateur, mais ne révoque pas les assistants qu'il a autorisés.
ADMIN_PASSWORD=

# Stockage du serveur (obligatoire en production) : connexions, comptes, clients OAuth, jetons.
# Choisissez UNE option. En développement, sans aucune des deux, le stockage se fait en mémoire.
#
# 1) Base relationnelle (serveur d'entreprise, voir deploy/windows/README.md), prioritaire si définie :
#    STORE_URL=mysql://mcp_server:MOT_DE_PASSE@127.0.0.1:3306/mcp_server
#    STORE_URL=sqlserver://mcp_server:MOT_DE_PASSE@127.0.0.1:1433/mcp_server
# STORE_URL=
#
# 2) MongoDB Atlas : chaîne « mongodb+srv://… » (Atlas → Connect → Drivers).
# L'intégration MongoDB Atlas de Vercel fournit directement MONGODB_URI.
MONGODB_URI=
# Base utilisée dans le cluster (par défaut « mcp_server »).
# MONGODB_DB=mcp_server


# Optionnel : URL publique du serveur (sinon déduite de la requête). Recommandé avec un domaine personnalisé.
# PUBLIC_BASE_URL=https://mon-serveur-mcp.vercel.app

# Optionnel, derrière un proxy de confiance : en-tête portant la vraie IP du visiteur
# (ex. cf-connecting-ip avec Cloudflare Tunnel). Sert à limiter les tentatives de mot de passe par IP.
# CLIENT_IP_HEADER=cf-connecting-ip
