# Clé servant à chiffrer les paramètres de connexion dans les URL MCP (obligatoire, 16 caractères minimum).
# Générez-la avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# La changer invalide toutes les URL déjà générées.
ENCRYPTION_KEY=

# Mot de passe exigé pour tester une connexion ou générer une URL depuis l'interface (fortement recommandé).
ADMIN_PASSWORD=

# Optionnel : URL publique utilisée dans les URL générées (sinon déduite de la requête).
# PUBLIC_BASE_URL=https://mon-serveur-mcp.vercel.app
