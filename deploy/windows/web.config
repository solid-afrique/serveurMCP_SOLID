<?xml version="1.0" encoding="utf-8"?>
<!--
  Hébergement du serveur MCP directement par IIS (déploiement manuel, voir IIS-MANUEL.md).
  IIS démarre et surveille Node.js grâce à l'ASP.NET Core Module V2 (inclus dans le .NET Hosting Bundle),
  et lui transmet les requêtes. Aucun service Windows n'est nécessaire.
  Si Node.js n'est pas dans « C:\Program Files\nodejs », adaptez processPath.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath="C:\Program Files\nodejs\node.exe"
                arguments=".\launcher.cjs"
                hostingModel="OutOfProcess"
                startupTimeLimit="120"
                requestTimeout="00:02:00"
                stdoutLogEnabled="true"
                stdoutLogFile=".\logs\stdout">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </aspNetCore>

    <!-- WebDAV intercepterait les requêtes PUT et DELETE de l'interface d'administration. -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>

    <!-- Les réponses d'erreur du serveur MCP (JSON) doivent arriver telles quelles aux assistants. -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- Les URL OAuth (paramètres PKCE, state, resource) peuvent dépasser la limite par défaut. -->
        <requestLimits maxQueryString="8192" maxUrl="8192" />
        <!-- Par précaution : configuration, application, journaux et scripts ne sont jamais servis. -->
        <hiddenSegments>
          <add segment=".env.local" />
          <add segment="app" />
          <add segment="logs" />
          <add segment="sql" />
          <add segment="iis" />
          <add segment="service" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".local" allowed="false" />
          <add fileExtension=".cjs" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
