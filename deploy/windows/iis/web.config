<?xml version="1.0" encoding="utf-8"?>
<!--
  Site IIS « proxy inverse » du serveur MCP.
  Toutes les requêtes sont transmises au service Windows mcp-db-server (http://127.0.0.1:3100).
  Prérequis : modules URL Rewrite et Application Request Routing (ARR), configurés par iis-setup.ps1.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Serveur MCP" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <!-- Vraie IP du visiteur (CLIENT_IP_HEADER=x-real-ip) et nom d'hôte public. -->
            <set name="HTTP_X_REAL_IP" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3100/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- WebDAV intercepterait les requêtes PUT et DELETE de l'interface d'administration. -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>

    <!-- Les réponses d'erreur du serveur MCP (JSON) doivent arriver telles quelles aux assistants. -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- Les URL OAuth (paramètres PKCE, state, resource) peuvent dépasser la limite par défaut. -->
        <requestLimits maxQueryString="8192" maxUrl="8192" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
