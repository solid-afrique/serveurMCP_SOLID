<?xml version="1.0" encoding="utf-8"?>
<!--
  Variante du web.config d'hébergement pour le module HttpPlatformHandler v1.2 (s'il est déjà installé).
  Pour l'utiliser : renommez ce fichier en web.config et placez-le à la racine du site, à la place de l'autre.
  Le chemin du lanceur est absolu : adaptez-le si le site n'est pas dans C:\inetpub\mcp-server.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                  arguments="&quot;C:\inetpub\mcp-server\launcher.cjs&quot;"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  requestTimeout="00:02:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>

    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <requestLimits maxQueryString="8192" maxUrl="8192" />
        <hiddenSegments>
          <add segment=".env.local" />
          <add segment="app" />
          <add segment="logs" />
          <add segment="sql" />
          <add segment="iis" />
          <add segment="service" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".local" allowed="false" />
          <add fileExtension=".cjs" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
