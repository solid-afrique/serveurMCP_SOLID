# Configuration du serveur MCP sur Windows Server.
# install.ps1 copie ce modèle en .env.local à la racine du projet : complétez ce fichier-là.

# Clé de chiffrement des paramètres de connexion (obligatoire). À GARDER EN LIEU SÛR :
# sans elle, les connexions enregistrées sont irrécupérables. Pour la générer :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_KEY=

# Compte administrateur (obligatoire). Identifiant : « admin » sauf si ADMIN_EMAIL est défini.
ADMIN_PASSWORD=
# ADMIN_EMAIL=admin

# Stockage du serveur dans MySQL (obligatoire) : utilisateurs, administrateurs, connexions, autorisations.
# Base créée avec deploy\windows\sql\mysql-stockage.sql.
# Caractères spéciaux du mot de passe à encoder : @ → %40   : → %3A   / → %2F   # → %23   % → %25
STORE_URL=mysql://mcp_server:MOT_DE_PASSE@127.0.0.1:3306/mcp_server

# Adresse HTTPS publique du serveur (celle du site IIS), sans / final.
PUBLIC_BASE_URL=https://mcp.exemple.com

# En-tête contenant la vraie IP du visiteur (limitation des tentatives de mot de passe) :
#   x-forwarded-for  : hébergement direct dans IIS (IIS-MANUEL.md) ;
#   x-real-ip        : service Windows + proxy IIS (iis-setup.ps1) ;
#   cf-connecting-ip : Cloudflare Tunnel.
# Vérification : /api/health doit afficher votre IP dans « ip ».
CLIENT_IP_HEADER=x-forwarded-for
